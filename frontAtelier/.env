# En local avec `npm run dev` : ne pas mettre une URL absolue vers :8080 ici,
# sinon le navigateur appelle directement le backend et le CORS bloque.
# Laisser commenté pour utiliser le proxy Vite (requêtes vers /api → http://localhost:8080).
# VITE_API_URL=http://localhost:8080/api

# Pour un build qui tape une API distante uniquement :
# VITE_API_URL=https://api.exemple.com/api
